generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Owner {
  id             String   @id @default(uuid())
  firstName      String
  lastName       String
  email          String   @unique
  phone          String
  departmentCode String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  dni            String   @unique
  user           User?
}

model User {
  id           String        @id @default(uuid())
  tower        String
  floor        String
  apartment    String
  ownerId      String?       @unique
  role         UserRole      @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  poolAccesses PoolAccess[]
  poolGuests   PoolGuest[]
  reservations Reservation[]
  owner        Owner?        @relation(fields: [ownerId], references: [id])

  @@unique([tower, floor, apartment])
}

model Grill {
  id           String        @id @default(uuid())
  name         String
  tower        String
  description  String?
  imageUrl     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]
}

model Reservation {
  id        String            @id @default(uuid())
  date      DateTime
  status    ReservationStatus @default(PENDING)
  userId    String
  grillId   String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  grill     Grill             @relation(fields: [grillId], references: [id])
  user      User              @relation(fields: [userId], references: [id])

  @@unique([grillId, date])
}

model PoolGuest {
  id             String       @id @default(uuid())
  firstName      String
  lastName       String
  documentNumber String?
  guestType      GuestType
  departmentCode String
  registeredById String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  poolAccesses   PoolAccess[]
  registeredBy   User         @relation(fields: [registeredById], references: [id])

  @@index([departmentCode])
}

model PoolAccess {
  id               String           @id @default(uuid())
  personType       String
  personName       String
  departmentCode   String
  guestType        GuestType?
  entryTime        DateTime         @default(now())
  estimatedHours   Int
  expectedExitTime DateTime
  actualExitTime   DateTime?
  status           PoolAccessStatus @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  ownerId          String?
  guestId          String?
  guest            PoolGuest?       @relation(fields: [guestId], references: [id])
  owner            User?            @relation(fields: [ownerId], references: [id])

  @@index([departmentCode])
  @@index([status])
  @@index([entryTime])
}

model PoolConfig {
  id          String   @id @default(uuid())
  maxCapacity Int      @default(25)
  openingTime String   @default("08:00")
  closingTime String   @default("22:00")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Staff {
  id        String    @id @default(uuid())
  username  String    @unique
  password  String
  firstName String
  lastName  String
  role      StaffRole
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum UserRole {
  USER
  ADMIN
}

enum StaffRole {
  ADMIN
  RECEPTIONIST
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum GuestType {
  RESIDENT
  FRIEND
  TENANT
  AIRBNB
}

enum PoolAccessStatus {
  ACTIVE
  COMPLETED
}

enum DocumentType {
  DNI
  PASSPORT
  CE
  OTHER
}

model Guest {
  id             String       @id @default(uuid())
  firstName      String
  lastName       String
  documentType   DocumentType @default(DNI)
  documentNumber String
  email          String?
  phone          String?
  departmentCode String
  guestType      GuestType    @default(AIRBNB)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([documentType, documentNumber])
  @@index([departmentCode])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Owner {
  id             String   @id @default(uuid())
  firstName      String
  lastName       String
  email          String   @unique
  phone          String
  departmentCode String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User?
}

model User {
  id           String        @id @default(uuid())
  tower        String
  floor        String
  apartment    String
  ownerId      String?       @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  owner        Owner?        @relation(fields: [ownerId], references: [id])
  reservations Reservation[]

  @@unique([tower, floor, apartment])
}

model Grill {
  id           String        @id @default(uuid())
  name         String
  tower        String
  description  String?
  imageUrl     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]
}

model Reservation {
  id        String            @id @default(uuid())
  date      DateTime
  status    ReservationStatus @default(PENDING)
  userId    String
  grillId   String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  grill Grill @relation(fields: [grillId], references: [id])

  @@unique([grillId, date])
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}
